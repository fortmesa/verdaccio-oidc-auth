{
  "name": "@fortmesa/verdaccio-oidc-auth",
  "version": "1.1.0",
  "description": "Verdaccio middleware plugin: verifies CI/CD platform OIDC ID tokens against their public JWKS and maps trusted claims to per-repository Verdaccio identities/groups",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fortmesa/verdaccio-oidc-auth.git"
  },
  "homepage": "https://github.com/fortmesa/verdaccio-oidc-auth#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "verdaccio",
    "verdaccio-plugin",
    "npm-registry",
    "oidc",
    "openid-connect",
    "ci-cd-authentication"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "files": [
    "index.js"
  ],
  "scripts": {
    "prepare": "husky",
    "test": "node test/smoke.js && node test/verdaccio.js"
  },
  "lint-staged": {
    "**/*.{js,yml,yaml,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "body-parser": "~1.20.5",
    "express": "4.22.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "verdaccio": "^6.10.7"
  }
}
